# Copy this file to ".env" (same folder) and fill in your own key(s).
# ".env" itself is gitignored and never committed — keep real keys out of
# version control, and never paste a real key into a chat/issue/PR.

# Optional. Only needed if you set a character's provider to "openrouter"
# in the persona editor (an online API, NOT local/offline — see README).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
